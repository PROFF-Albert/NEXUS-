<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>ELEV8</title>
    <link rel="stylesheet" href="gym.css">
</head>

<body>

    <header class="nav-inner" id="site-header">
        <div class="container navbar">
            <a class="logo" href="ownersdashboard.html">ELEV<span>8</span></a>
            <ul class="nav-links">
                <li><a href="ownersdashboard.html">Dashboard</a></li>
                <li><a href="owners-members.html" class="active">Members</a></li>
                <li><a href="subscription.html">Subscriptions</a></li>
                <li><a href="payment.html">Payments</a></li>
                <li><a href="gym-profile.html">Gym Profile</a></li>
                <li><a href="settings.html">Settings</a></li>
            </ul>
            <div class="nav-action">
                <button class="btn" onclick="handleLogout()">Logout</button>
            </div>
            <button class="hamburger" id="hamburger" aria-label="Open menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <nav class="mobile-nav" id="mobile-nav">
        <a href="ownersdashboard.html">Dashboard</a>
        <a href="owners-members.html">Members</a>
        <a href="subscription.html">Subscriptions</a>
        <a href="payment.html">Payments</a>
        <a href="gym-profile.html">Gym Profile</a>
        <a href="settings.html">Settings</a>
        <button class="btn" onclick="handleLogout()">Logout</button>
    </nav>

    <div class="page-offset"></div>

    <div class="page-banner">
        <div class="container">
            <div class="banner-eyebrow">Owner Members</div>
            <h1>Members</h1>
            <p>Track active memberships, search records, and open a member profile fast.</p>
            <div class="banner-pills">
                <span class="banner-pill">Total Members: 0</span>
                <span class="banner-pill">Active: 0</span>
                <span class="banner-pill">Expiring Soon: 0</span>
            </div>
        </div>
    </div>

    <section class="section">
        <div class="container">

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Total Members</div>
                    <div class="stat-value">0</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Active Memberships</div>
                    <div class="stat-value accent">0</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Expiring This Week</div>
                    <div class="stat-value">0</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Checked In Today</div>
                    <div class="stat-value">0</div>
                </div>
            </div>

            <div class="section-header">
                <div class="search-input-wrap" style="margin-bottom:0;max-width:420px">
                    <input type="text" placeholder="Search members by name, email, or plan…">
                </div>
                <button class="btn btn-secondary btn-sm" type="button">Export List</button>
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Plan</th>
                            <th>Status</th>
                            <th>Last Check-in</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" style="text-align:center;color:var(--muted);padding:40px">
                                No members have been loaded yet.
                            </td>
                        </tr>
                        <tr style="display:none">
                            <td>Jane Doe</td>
                            <td>jane@example.com</td>
                            <td>Monthly</td>
                            <td><span class="badge badge-green">Active</span></td>
                            <td>Today</td>
                            <td>
                                <a href="member-profile.html" class="btn btn-sm">View</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

           

        </div>
    </section>

    <footer>
        <div class="container">
            <div class="footer-inner">
                <span class="footer-logo">ELEV<span>8</span></span>
                <span>© 2026 ELEV8. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script>
        const hamburger = document.getElementById('hamburger');
        const mobileNav = document.getElementById('mobile-nav');
        hamburger.addEventListener('click', () => mobileNav.classList.toggle('open'));
    </script>

    <script type="module" src="auth.js"></script>
</body>

</html>
