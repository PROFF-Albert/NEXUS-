<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>ELEV8 </title>
    <link rel="stylesheet" href="gym.css">
</head>

<body>

    <header class="nav-inner" id="site-header">
        <div class="container navbar">
            <a class="logo" href="ownersdashboard.html">ELEV<span>8</span></a>
            <ul class="nav-links">
                <li><a href="ownersdashboard.html">Dashboard</a></li>
                <li><a href="owners-members.html">Members</a></li>
                <li><a href="subscription.html">Subscriptions</a></li>
                <li><a href="payment.html">Payments</a></li>
                <li><a href="gym-profile.html">Gym Profile</a></li>
                <li><a href="settings.html">Settings</a></li>
            </ul>
            <div class="nav-action">
                <button class="btn" onclick="handleLogout()">Logout</button>
            </div>
            <button class="hamburger" id="hamburger" aria-label="Open menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <nav class="mobile-nav" id="mobile-nav">
        <a href="ownersdashboard.html">Dashboard</a>
        <a href="owners-members.html">Members</a>
        <a href="subscription.html">Subscriptions</a>
        <a href="payment.html">Payments</a>
        <a href="gym-profile.html">Gym Profile</a>
        <a href="settings.html">Settings</a>
        <button class="btn" onclick="handleLogout()">Logout</button>
    </nav>

    <div class="page-offset"></div>

    <div class="page-banner">
        <div class="container">
            <h1>Choose Your Plan</h1>
            <p>Pick the ELEV8 owner plan that fits your gym's size and needs.</p>
        </div>
    </div>

    <section class="section">
        <div class="container">
            <div class="gym-grid">

                <div class="plan-card">
                    <h3>Basic</h3>
                    <div class="plan-price">₵—<span> / month</span></div>
                    <p>Perfect for small gyms just getting started on ELEV8.</p>
                    <ul style="font-size:14px;color:var(--muted);line-height:2;padding-left:4px;list-style:none">
                        <li>✓ Up to 50 members</li>
                        <li>✓ Basic analytics</li>
                        <li>✓ Gym listing</li>
                    </ul>
                    <button class="btn">Select Plan</button>
                </div>

                <div class="plan-card featured">
                    <h3>Pro</h3>
                    <div class="plan-price">₵—<span> / month</span></div>
                    <p>For growing gyms that need advanced member management tools.</p>
                    <ul style="font-size:14px;color:var(--muted);line-height:2;padding-left:4px;list-style:none">
                        <li>✓ Up to 200 members</li>
                        <li>✓ Revenue reports</li>
                        <li>✓ Priority listing</li>
                    </ul>
                    <button class="btn">Select Plan</button>
                </div>

                <div class="plan-card">
                    <h3>Premium</h3>
                    <div class="plan-price">₵—<span> / month</span></div>
                    <p>Unlimited everything for established fitness businesses.</p>
                    <ul style="font-size:14px;color:var(--muted);line-height:2;padding-left:4px;list-style:none">
                        <li>✓ Unlimited members</li>
                        <li>✓ Advanced analytics</li>
                        <li>✓ Featured listing</li>
                    </ul>
                    <button class="btn">Select Plan</button>
                </div>

            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <div class="footer-inner">
                <span class="footer-logo">ELEV<span>8</span></span>
                <span>© 2026 ELEV8. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script>
        const hamburger = document.getElementById('hamburger');
        const mobileNav = document.getElementById('mobile-nav');
        hamburger.addEventListener('click', () => mobileNav.classList.toggle('open'));
    </script>

    <script type="module" src="auth.js"></script>
</body>

</html>
