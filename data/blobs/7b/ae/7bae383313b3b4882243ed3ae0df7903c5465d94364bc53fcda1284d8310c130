<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="elev8-favicon-package/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="elev8-favicon-package/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="elev8-favicon-package/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="elev8-favicon-package/apple-touch-icon.png">
    <link rel="manifest" href="elev8-favicon-package/site.webmanifest">
    <link rel="icon" href="elev8-favicon-package/favicon.ico">
    <title>ELEV8 </title>
    <link rel="stylesheet" href="gym.css">
</head>

<body>

    <header class="nav-inner" id="site-header">
        <div class="container navbar">
            <a class="logo" href="index.html">ELEV<span>8</span></a>
            <ul class="nav-links">
                <li><a href="userdashboard.html">Dashboard</a></li>
                <li><a href="gyms.html" class="active">Find Gyms</a></li>
                <li><a href="userdashboard.html">Profile</a></li>
            </ul>
            <div class="nav-action">
                <button class="btn" onclick="handleLogout()">Logout</button>
            </div>
            <button class="hamburger" id="hamburger" aria-label="Open menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <nav class="mobile-nav" id="mobile-nav">
        <a href="userdashboard.html">Dashboard</a>
        <a href="gyms.html">Find Gyms</a>
        <button class="btn" onclick="handleLogout()">Logout</button>
    </nav>

    <div class="page-offset"></div>

    <div id="gym-page-state" class="section" style="display:none">
        <div class="container">
            <p class="table-loading">Loading gym details…</p>
        </div>
    </div>

    <div id="gym-main-content">

        <div class="page-banner">
            <div class="container">
                <h1 id="gym-page-title">Gym Name</h1>
                <p id="gym-banner-meta"> Location &nbsp;·&nbsp; ★ Rating &nbsp;·&nbsp; From ₵—/mo</p>
            </div>
        </div>

        <section class="section">
            <div class="container">
                <div class="profile-card">
                    <div class="info-grid">
                        <div class="info-item">
                            <label>Location</label>
                            <p id="gym-location-value">—</p>
                        </div>
                        <div class="info-item">
                            <label>Rating</label>
                            <p id="gym-price-value">—</p>
                        </div>
                        <div class="info-item">
                            <label>Description</label>
                            <p id="gym-description-value">—</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" style="padding-top:0">
            <div class="container">
                <h2 class="section-title">Gallery</h2>
                <div class="gallery-grid">
                    <img id="gym-hero-image" class="gallery-hero" alt="Gym photo"
                        style="width:100%;border-radius:12px;object-fit:cover;transition:opacity .15s ease">
                </div>
                <div id="gym-gallery-thumbs" class="gallery-thumbs"
                    style="display:flex;gap:10px;margin-top:14px;flex-wrap:wrap"></div>
            </div>
        </section>

        <section class="section" style="padding-top:0">
            <div class="container">
                <h2 class="section-title">Membership Plans</h2>
                <div class="gym-grid" id="gym-plans-container">
                </div>
            </div>
        </section>

        <section class="section" style="padding-top:0">
            <div class="container">
                <h2 class="section-title">Gym Schedule</h2>
                <div class="table-wrapper">
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th>Day</th>
                                <th>Opens</th>
                                <th>Closes</th>
                            </tr>
                        </thead>
                        <tbody id="gym-schedule-tbody">
                            <tr>
                                <td colspan="3" class="table-loading">Loading schedule…</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="section" style="padding-top:0">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title" style="margin-bottom:0">Contact</h2>
                    <a href="user-subscription.html" class="btn">Join This Gym</a>
                </div>
                <div class="contact-block">
                    <div class="contact-row">
                        <span class="contact-icon"></span>
                        <div><strong>Phone</strong><br><span id="gym-contact-phone">—</span></div>
                    </div>
                    <div class="contact-row">
                        <span class="contact-icon"></span>
                        <div><strong>Email</strong><br><span id="gym-contact-email">—</span></div>
                    </div>
                    <div class="contact-row">
                        <span class="contact-icon"></span>
                        <div><strong>Address</strong><br><span id="gym-contact-address">—</span></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" id="gym-related-section" style="padding-top:0">
            <div class="container">
                <h2 class="section-title">Similar Gyms Nearby</h2>
                <div class="gym-grid" id="gym-related-container">
                </div>
            </div>
        </section>

    </div>

    <footer>
        <div class="container">
            <div class="footer-inner">
                <span class="footer-logo">ELEV<span>8</span></span>
                <span>© 2026 ELEV8. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script>
        const hamburger = document.getElementById('hamburger');
        const mobileNav = document.getElementById('mobile-nav');
        hamburger.addEventListener('click', () => mobileNav.classList.toggle('open'));
    </script>

    <script type="module" src="auth.js"></script>
    <script type="module" src="gym-details.js"></script>
</body>

</html>
